{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run MiniZinc file",
            "type": "shell",
            "command": "minizinc ${workspaceFolder}/mzn_model/ssc.mzn ${workspaceFolder}/data/ssg-Chalo.dzn",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "clear": true
            },
            "problemMatcher": []
        },
        // ------------------------------------------------------------------------
        {
            "label": "Run Python file",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python ${workspaceFolder}/ssc.py", 
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}